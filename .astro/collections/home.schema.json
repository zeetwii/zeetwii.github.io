{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "avatarImage": {
      "type": "object",
      "properties": {
        "src": {
          "type": "string"
        },
        "alt": {
          "default": "My avatar",
          "type": "string"
        }
      },
      "required": [
        "src"
      ]
    },
    "githubCalendar": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  }
}